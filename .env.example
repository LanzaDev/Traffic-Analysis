# Rastreamento e Análise de Tráfego — variáveis de ambiente
# Copie este arquivo para .env e ajuste os valores conforme necessário.
# As variáveis de ambiente do SO sobrescrevem este arquivo.
# Precedência final: argumento CLI > variável de ambiente > padrão do código.

# Modelo YOLO (Ultralytics). Ex: yolov8n.pt, yolo11n.pt, yolo_traffic.pt, yolo_traffic_classes.pt.
TRAFFIC_MODEL_PATH=models/yolo_traffic_classes.pt

# Fonte de vídeo padrão: caminho .mp4/.avi, URL RTSP/HTTP ou índice de webcam.
TRAFFIC_DEFAULT_SOURCE=assets/traffic.mp4

# Algoritmo de rastreamento: bytetrack ou botsort.
TRAFFIC_TRACKER=bytetrack

# Diretório de saída para vídeos anotados e relatórios.
TRAFFIC_OUTPUT_DIR=output

# Frame skipping: processa 1 a cada N frames (desempenho em tempo real/CCTV).
TRAFFIC_SKIP_FRAMES=1

# Limiares de detecção.
TRAFFIC_CONF=0.25
TRAFFIC_IOU=0.5

# Tamanho de inferência (pixels).
TRAFFIC_IMG_SIZE=640

# Dispositivo: cpu, 0 (GPU) ou auto.
TRAFFIC_DEVICE=cpu

# Arquivos de configuração (caminhos relativos à raiz do projeto).
TRAFFIC_ZONES_FILE=config/zones.json
TRAFFIC_SPEED_CONFIG_FILE=config/speed.json

# Gravar vídeo anotado? (true/false)
TRAFFIC_SAVE_VIDEO=false

# Modo headless (não exibe janela)? (true/false)
TRAFFIC_NO_SHOW=false

# Limite máximo de frames processados (0 = todos).
TRAFFIC_MAX_FRAMES=0

# Nome base para arquivos de saída.
TRAFFIC_RUN_NAME=

# Imprimir relatório JSON no stdout? (true/false)
TRAFFIC_JSON_OUTPUT=false

# Formato do JSON: pretty ou compact.
TRAFFIC_REPORT_FORMAT=pretty

# Tamanho do lote para inferência em batch (1 = sem batch).
TRAFFIC_BATCH_SIZE=1

# Exportar modelo: onnx, engine (TensorRT), openvino, ncnn.
TRAFFIC_EXPORT_FORMAT=

# Caminho para modelo TensorRT já exportado (.engine).
TRAFFIC_ENGINE_PATH=

# Filtro de Kalman para velocidade (substitui EMA).
TRAFFIC_KALMAN_PROCESS_NOISE=1.0
TRAFFIC_KALMAN_MEASUREMENT_NOISE=10.0

# Limite de confiança para exibir velocidade.
TRAFFIC_MIN_DETECTION_FRAMES=3
TRAFFIC_MIN_CONFIDENCE=0.3
